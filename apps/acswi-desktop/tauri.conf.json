{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Account Switcher",
  "version": "0.2.0",
  "identifier": "dev.openroot.acswi",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Account Switcher",
        "width": 440,
        "height": 640,
        "minWidth": 360,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
